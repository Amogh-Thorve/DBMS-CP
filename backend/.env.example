# Application Settings
APP_NAME="STVAMS - Smart Traffic Violation & Vehicle Analytics Management System"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=stvams_super_secret_jwt_key_change_in_production_2026

# Oracle Database Settings
ORACLE_USER=stvams_user
ORACLE_PASSWORD=stvams_password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_DSN=localhost:1521/FREEPDB1

# MongoDB Settings
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=stvams_events

# Elasticsearch Settings
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=traffic_violations

# Analytics & Storage Paths
PARQUET_OUTPUT_DIR=../data/parquet
HDFS_URL=http://localhost:9870
